# Install with `crontab cron.example` only after replacing PROJECT_ROOT.
# The job runs every Monday at 09:00 in the host's local timezone.
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
PROJECT_ROOT=/path/to/Project_1_Frenchway

0 9 * * 1 cd $PROJECT_ROOT && ./frenchway/bin/python scripts/run_pipeline.py >> data/runs/scheduler.log 2>&1
